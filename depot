#!/usr/bin/env ruby
# depot — install and update every service running on this NAS.
#
# Run `depot` (no args) for the help menu. The full command list lives
# in the COMMANDS hash a few lines down; the help text is generated
# from it. Adding a command = add one entry to COMMANDS, no other
# changes needed.
#
# Installable from anywhere on the box by running install/depot-cli once,
# which symlinks this script to /usr/local/bin/depot.
#
# Reading guide: scroll to the bottom. The COMMANDS hash IS the
# command surface. The SERVICES array IS the install order. Every
# service is a module under services/<name>/<name>.rb, implementing
# four class methods: install_prompt, install(prompts), update,
# summary. Adding a new service = define the module + add it to
# SERVICES.

# Ctrl-C is intentional 99% of the time (cancel a prompt mid-input,
# bail during a long install). Trapping SIGINT here turns the noisy
# Ruby stack trace into a clean exit. Ctrl-D in a prompt also raises
# Interrupt and is caught by the rescue below.
Signal.trap("INT") do
  # Restore the terminal cursor in case Ctrl-C happens mid-spinner.
  # `\e[?25h` is the show-cursor sequence; with_spinner sets `\e[?25l`
  # to hide it during work. Without restoring here, a Ctrl-C'd run
  # would leave the cursor invisible in the shell that runs depot.
  STDOUT.print("\e[?25h")
  puts
  exit 130
end

require_relative 'services/helpers'

# Load every service module. Sorted so the require order is
# deterministic; the actual install/update order is the SERVICES array.
Dir[File.join(__dir__, 'services', '*', '*.rb')].sort.each { |f| require f }

# Service install order. Storage before Docker (containers need a place
# to bind-mount volumes from). Docker before any container. Tailscale
# before any tailscale_serve mapping. Autologin anywhere before the
# install ends. Gluetun before qBittorrent (they share a netns).
# Jellyfin before Sonarr/Radarr/Jellyseerr/Aviary (they all wire to it).
SERVICES = [
  Storage,
  Docker,
  Tailscale,
  Autologin,
  Gluetun,
  Jellyfin,
  QBittorrent,
  Sonarr,
  Radarr,
  Prowlarr,
  Sabnzbd,
  Jellyseerr,
  Aviary,
  Unpackerr,
  # Cloudflare Tunnel runs last — it's the public-facing layer
  # and only meaningful once aviary is up to receive traffic.
  Cloudflare,
]

# Commands. Each entry: description for the help menu, action for the
# work. After any command runs (other than `help`, which exit's early),
# the summary block prints automatically — that's why `summary`'s
# action is empty.
COMMANDS = {
  "help" => {
    description: "Show this help and exit",
    needs_sudo: false,
    action: -> { print_help; exit 0 },
  },
  "install" => {
    description: "Install every service from scratch (prompts collected up front)",
    needs_sudo: true,
    action: -> {
      # Prompts run OUTSIDE any spinner — they're interactive.
      prompts = SERVICES.each_with_object({}) do |service, hash|
        hash.merge!(service.install_prompt)
      end
      SERVICES.each do |service|
        with_spinner("#{service.name} install") { service.install(prompts) }
      end
    },
  },
  "update" => {
    description: "Pull depot (no arg) or update one service (`depot update aviary`)",
    needs_sudo: false,  # conditional below — set to true if ARGV[1] is a service
    action: -> {
      target = ARGV[1]
      if target.nil?
        # __dir__ in this lambda resolves to depot's repo root.
        # --ff-only refuses to auto-merge if you've made local edits —
        # better to surface that as an error than silently merge.
        with_spinner("depot update") do
          sh!("git -C #{__dir__} pull --ff-only")
        end
      elsif (service = SERVICES.find { |s| s.name.downcase == target.downcase })
        with_spinner("#{service.name} update") { service.update }
      else
        abort "Unknown service: #{target.inspect}. Known: #{SERVICES.map { |s| s.name.downcase }.join(", ")}"
      end
    },
  },
  "upgrade" => {
    description: "Same as `update` — included so either verb works",
    needs_sudo: false,  # see update's note
    action: -> { COMMANDS["update"][:action].call },
  },
  "summary" => {
    description: "Print URLs and status for every service",
    needs_sudo: true,  # zpool list, docker logs, docker ps
    action: -> { },  # empty — summary block runs automatically after dispatch
  },
  "completion" => {
    description: "Print the zsh completion script (already installed by install/depot-cli)",
    needs_sudo: false,
    action: -> { print_zsh_completion; exit 0 },
  },
}.freeze

def print_help
  puts "Usage: depot <command> [<service>]"
  puts
  puts "Commands:"
  COMMANDS.each do |name, cmd|
    puts "  #{name.ljust(10)} #{cmd[:description]}"
  end
  puts
  puts "Services (for `depot update <service>`): #{SERVICES.map { |s| s.name.downcase }.join(", ")}"
end

# Emit a zsh completion file in fpath/autoload format. Both COMMANDS
# and SERVICES are walked at emit time so re-running this after adding
# a new command or service produces an up-to-date completion list —
# there's no static word list to keep in sync.
#
# Output is the body of an autoloaded completion function — the
# `#compdef depot` directive at the top is what tells zsh's compinit
# to register this file as the completion for the `depot` command.
# install/depot-cli writes the output to /usr/share/zsh/site-functions/_depot,
# which is in zsh's default fpath, so completion just works in every
# new zsh shell with no shellrc changes.
def print_zsh_completion
  commands = COMMANDS.map { |name, cmd| "#{name}:#{cmd[:description]}" }
  services = SERVICES.map { |s| "#{s.name.downcase}:Update #{s.name}" }

  # Position 1 (the command): always offered from our static list,
  # nothing else — no file/dir fallback.
  # Position 2 (the service arg): only meaningful after `update` /
  # `upgrade`; for any other position-1, position 2 completes to
  # nothing (no file fallback either).
  puts "#compdef depot"
  puts
  puts "_arguments \\"
  puts "  '1:command:->command' \\"
  puts "  '2:service:->service'"
  puts
  puts "case $state in"
  puts "  command)"
  puts "    local -a candidates"
  puts "    candidates=("
  commands.each { |c| puts "      #{zsh_quote(c)}" }
  puts "    )"
  puts "    _describe 'depot command' candidates"
  puts "    ;;"
  puts "  service)"
  puts "    case ${words[2]} in"
  puts "      update|upgrade)"
  puts "        local -a services"
  puts "        services=("
  services.each { |s| puts "          #{zsh_quote(s)}" }
  puts "        )"
  puts "        _describe 'service' services"
  puts "        ;;"
  puts "    esac"
  puts "    ;;"
  puts "esac"
end

# Wrap a string in single quotes for safe embedding in a zsh array
# literal. Single quotes (not double) so backticks inside the string
# can't be interpreted as command substitution. The `'\''` dance is
# the standard way to embed a literal single quote in a single-quoted
# shell string. UTF-8 passes through as-is (no escape).
def zsh_quote(str)
  "'" + str.gsub("'", "'\\''") + "'"
end

mode = ARGV.first || "help"

# Warm sudo's timestamp so the first sudo call mid-run doesn't bisect
# output with a password prompt. Most commands declare their sudo
# need via COMMANDS. The one runtime check: `depot update <service>`
# is a service update (every service does docker / tailscale work),
# while `depot update` alone is just a git pull. We detect the
# service-arg form by checking ARGV[1].
needs_sudo =
  if (mode == "update" || mode == "upgrade") && ARGV[1] &&
     SERVICES.any? { |s| s.name.downcase == ARGV[1].downcase }
    true
  elsif COMMANDS.key?(mode)
    COMMANDS[mode][:needs_sudo]
  else
    false  # unknown command — print help and exit, no sudo needed
  end

if needs_sudo
  system("sudo -v") || abort("sudo failed")
end

begin
  if COMMANDS.key?(mode)
    COMMANDS[mode][:action].call
  else
    puts "Unknown command: #{mode.inspect}"
    puts
    print_help
    exit 1
  end

  puts
  puts "═══ Summary ═══"
  SERVICES.each(&:summary)
rescue Interrupt
  puts
  exit 130
end
