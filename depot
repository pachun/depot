#!/usr/bin/env ruby
# depot — install and update every service running on this NAS.
#
# Run `depot` (no args) for the help menu. The full command list lives
# in the COMMANDS hash a few lines down; the help text is generated
# from it. Adding a command = add one entry to COMMANDS, no other
# changes needed.
#
# Installable from anywhere on the box by running install/depot-cli once,
# which symlinks this script to /usr/local/bin/depot.
#
# Reading guide: scroll to the bottom. The COMMANDS hash IS the
# command surface. The SERVICES array IS the install order. Every
# service is a module under services/<name>/<name>.rb, implementing
# four class methods: install_prompt, install(prompts), update,
# summary. Adding a new service = define the module + add it to
# SERVICES.

# Ctrl-C is intentional 99% of the time (cancel a prompt mid-input,
# bail during a long install). Trapping SIGINT here turns the noisy
# Ruby stack trace into a clean exit. Ctrl-D in a prompt also raises
# Interrupt and is caught by the rescue below.
Signal.trap("INT") { puts; exit 130 }

require_relative 'services/helpers'

# Load every service module. Sorted so the require order is
# deterministic; the actual install/update order is the SERVICES array.
Dir[File.join(__dir__, 'services', '*', '*.rb')].sort.each { |f| require f }

# Service install order. Storage before Docker (containers need a place
# to bind-mount volumes from). Docker before any container. Tailscale
# before any tailscale_serve mapping. Autologin anywhere before the
# install ends. Gluetun before qBittorrent (they share a netns).
# Jellyfin before Sonarr/Radarr/Jellyseerr/Aviary (they all wire to it).
SERVICES = [
  Storage,
  Docker,
  Tailscale,
  Autologin,
  Gluetun,
  Jellyfin,
  QBittorrent,
  Sonarr,
  Radarr,
  Prowlarr,
  Sabnzbd,
  Jellyseerr,
  Aviary,
  Unpackerr,
]

# Commands. Each entry: description for the help menu, action for the
# work. After any command runs (other than `help`, which exit's early),
# the summary block prints automatically — that's why `summary`'s
# action is empty.
COMMANDS = {
  "help" => {
    description: "Show this help and exit",
    needs_sudo: false,
    action: -> { print_help; exit 0 },
  },
  "install" => {
    description: "Install every service from scratch (prompts collected up front)",
    needs_sudo: true,
    action: -> {
      puts "depot install — collecting prompts (walk away after these)."
      puts
      prompts = SERVICES.each_with_object({}) do |service, hash|
        hash.merge!(service.install_prompt)
      end
      puts
      puts "Installing #{SERVICES.size} services..."
      SERVICES.each do |service|
        puts
        puts "═══ #{service.name} ═══"
        service.install(prompts)
      end
    },
  },
  "update" => {
    description: "Bring every service to its current desired state",
    needs_sudo: true,
    action: -> {
      puts "depot update — bringing every service to current desired state."
      SERVICES.each do |service|
        puts
        puts "═══ #{service.name} ═══"
        service.update
      end
    },
  },
  "summary" => {
    description: "Print URLs and status for every service",
    needs_sudo: true,  # zpool list, docker logs, docker ps
    action: -> { },  # empty — summary block runs automatically after dispatch
  },
  "completion" => {
    description: "Print the zsh completion script (already installed by install/depot-cli)",
    needs_sudo: false,
    action: -> { print_zsh_completion; exit 0 },
  },
}.freeze

def print_help
  puts "Usage: depot <command>"
  puts
  puts "Commands:"
  COMMANDS.each do |name, cmd|
    puts "  #{name.ljust(10)} #{cmd[:description]}"
  end
  puts "  <service>  Update just one service (e.g. `depot aviary`)"
  puts
  puts "Services: #{SERVICES.map { |s| s.name.downcase }.join(", ")}"
end

# Emit a zsh completion file in fpath/autoload format. Both COMMANDS
# and SERVICES are walked at emit time so re-running this after adding
# a new command or service produces an up-to-date completion list —
# there's no static word list to keep in sync.
#
# Output is the body of an autoloaded completion function — the
# `#compdef depot` directive at the top is what tells zsh's compinit
# to register this file as the completion for the `depot` command.
# install/depot-cli writes the output to /usr/share/zsh/site-functions/_depot,
# which is in zsh's default fpath, so completion just works in every
# new zsh shell with no shellrc changes.
def print_zsh_completion
  candidates = COMMANDS.map { |name, cmd| "#{name}:#{cmd[:description]}" }
  candidates += SERVICES.map { |s| "#{s.name.downcase}:Update #{s.name}" }

  puts "#compdef depot"
  puts
  puts "local -a candidates"
  puts "candidates=("
  candidates.each { |c| puts "  #{c.dump}" }
  puts ")"
  puts "_describe 'depot command' candidates"
end

mode = ARGV.first || "help"

# Warm sudo's timestamp so the first sudo call mid-run doesn't bisect
# output with a password prompt. Each COMMANDS entry declares whether
# it needs sudo; single-service updates always do (every service does
# docker / tailscale work).
needs_sudo =
  if COMMANDS.key?(mode)
    COMMANDS[mode][:needs_sudo]
  elsif SERVICES.any? { |s| s.name.downcase == mode.downcase }
    true
  else
    false  # unknown command — print help and exit, no sudo needed
  end

if needs_sudo
  system("sudo -v") || abort("sudo failed")
end

begin
  if COMMANDS.key?(mode)
    COMMANDS[mode][:action].call
  elsif (service = SERVICES.find { |s| s.name.downcase == mode.downcase })
    puts "depot #{mode} — updating just #{service.name}."
    service.update
  else
    puts "Unknown command: #{mode.inspect}"
    puts
    print_help
    exit 1
  end

  puts
  puts "═══ Summary ═══"
  SERVICES.each(&:summary)
rescue Interrupt
  puts
  exit 130
end
