#!/usr/bin/env ruby
# depot — install and update every service running on this NAS.
#
# Run `depot` (no args) for the help menu. The full command list lives
# in the COMMANDS hash a few lines down; the help text is generated
# from it. Adding a command = add one entry to COMMANDS, no other
# changes needed.
#
# Installable from anywhere on the box by running install/depot-cli once,
# which symlinks this script to /usr/local/bin/depot.
#
# Reading guide: scroll to the bottom. The COMMANDS hash IS the
# command surface. The SERVICES array IS the install order. Every
# service is a module under services/<name>/<name>.rb, implementing
# four class methods: install_prompt, install(prompts), update,
# summary. Adding a new service = define the module + add it to
# SERVICES.

# Ctrl-C is intentional 99% of the time (cancel a prompt mid-input,
# bail during a long install). Trapping SIGINT here turns the noisy
# Ruby stack trace into a clean exit. Ctrl-D in a prompt also raises
# Interrupt and is caught by the rescue below.
Signal.trap("INT") do
  # Restore the terminal cursor in case Ctrl-C happens mid-spinner.
  # `\e[?25h` is the show-cursor sequence; with_spinner sets `\e[?25l`
  # to hide it during work. Without restoring here, a Ctrl-C'd run
  # would leave the cursor invisible in the shell that runs depot.
  STDOUT.print("\e[?25h")
  puts
  exit 130
end

Encoding.default_external = Encoding::UTF_8

require_relative 'services/helpers'

# Load every service module. Sorted so the require order is
# deterministic; the actual install/update order is the SERVICES array.
Dir[File.join(__dir__, 'services', '*', '*.rb')].sort.each { |f| require f }

# A demo server plays what is copied onto it and nothing else: a plain
# folder instead of the ZFS pool, and none of the download services.
# `depot install demo` marks the machine as one, and every later
# `depot update` reads the mark, so the two kinds never mix.
DEMO              = "demo"
SERVER_KIND_FILE  = File.join(Dir.home, "hdds/.config/depot/server_kind")
NAS_ADMIN_ANSWERS = File.join(Dir.home, "hdds/.config/depot/admin.env")

def marked_as_demo_server?
  File.file?(SERVER_KIND_FILE) && File.read(SERVER_KIND_FILE).strip == DEMO
end

def asked_to_install_a_demo_server?
  ARGV[0] == "install" && ARGV[1] == DEMO
end

def already_a_nas?
  File.file?(NAS_ADMIN_ANSWERS) && !marked_as_demo_server?
end

def mark_as_demo_server
  abort "This machine is already set up as a NAS; a demo server needs its own machine." if already_a_nas?
  FileUtils.mkdir_p(File.dirname(SERVER_KIND_FILE))
  File.write(SERVER_KIND_FILE, DEMO + "\n")
end

mark_as_demo_server if asked_to_install_a_demo_server?

# Service install order. Storage before Docker (containers need a place
# to bind-mount volumes from). Docker before any container. Tailscale
# before any tailscale_serve mapping. Autologin anywhere before the
# install ends.
# Jellyfin before Sonarr/Radarr/Jellyseerr/Aviary (they all wire to it).
NAS_SERVICES = [
  Storage,
  Docker,
  Tailscale,
  Autologin,
  Jellyfin,
  Sonarr,
  Radarr,
  # Bazarr after Sonarr/Radarr/Jellyfin: it needs all three API keys.
  Bazarr,
  Prowlarr,
  Sabnzbd,
  Jellyseerr,
  # Cloudflare Tunnel must run BEFORE Aviary: it persists the
  # public hostname to disk and Aviary's bring_up reads that
  # hostname to set PHX_HOST + CHECK_ORIGINS in its compose env.
  # Cloudflared starting before Aviary is harmless — it forwards
  # to localhost:4000 which 502s until Aviary comes up moments
  # later. Cheap to skip when the token is blank (cloudflare.install
  # returns early).
  Cloudflare,
  Aviary,
  Unpackerr,
]

DEMO_SERVICES = [
  FolderStorage,
  Docker,
  Tailscale,
  Jellyfin,
  Jellyseerr,
  Cloudflare,
  Aviary,
  DemoContent,
]

SERVICES = marked_as_demo_server? ? DEMO_SERVICES : NAS_SERVICES
STORAGE  = SERVICES.first

RUNNING_LATEST_DEPOT = "DEPOT_RUNNING_LATEST"

def services_named(name)
  return SERVICES if name.nil?

  service = SERVICES.find { |s| s.name.downcase == name.downcase }
  abort "Unknown service: #{name.inspect}. Known: #{SERVICES.map { |s| s.name.downcase }.join(", ")}" if service.nil?
  [service]
end

# The process that pulls is still running the code it loaded before the
# pull, so it hands over to a fresh one that loads what the pull
# brought in. --ff-only refuses to auto-merge local edits — better to
# surface that as an error than silently merge.
def run_latest_depot
  depot = File.realpath(__FILE__)
  with_spinner("depot pull") { sh!("git -C #{File.dirname(depot)} pull --ff-only") }
  exec({ RUNNING_LATEST_DEPOT => "1" }, RbConfig.ruby, depot, *ARGV)
end

# Commands. Each entry: description for the help menu, action for the
# work. After any command runs (other than `help`, which exit's early),
# the summary block prints automatically — that's why `summary`'s
# action is empty.
COMMANDS = {
  "help" => {
    description: "Show this help and exit",
    needs_sudo: false,
    action: -> { print_help; exit 0 },
  },
  "install" => {
    description: "Install every service from scratch (`install demo` for a demo server)",
    needs_sudo: true,
    action: -> {
      # Prompts run OUTSIDE any spinner — they're interactive.
      prompts = SERVICES.each_with_object({}) do |service, hash|
        hash.merge!(service.install_prompt)
      end
      SERVICES.each do |service|
        with_spinner("#{service.name} install") { service.install(prompts) }
      end
    },
  },
  "update" => {
    description: "Pull depot, then update every service or just one",
    needs_sudo: true,
    action: -> {
      services_to_update = services_named(ARGV[1])
      run_latest_depot unless ENV.key?(RUNNING_LATEST_DEPOT)
      services_to_update.each do |service|
        with_spinner("#{service.name} update") { service.update }
      end
    },
  },
  "upgrade" => {
    description: "Alias for `update`",
    needs_sudo: true,
    action: -> { COMMANDS["update"][:action].call },
  },
  "summary" => {
    description: "Print service URLs and status",
    needs_sudo: true,  # zpool list, docker logs, docker ps
    action: -> { },  # empty — summary block runs automatically after dispatch
  },
  "backup" => {
    description: "Save install credentials to a file",
    needs_sudo: false,  # everything we read is user-owned
    action: -> {
      target = ARGV[1]
      timestamp = Time.now.strftime("%Y-%m-%d-%H%M%S")
      out_root = File.join(Dir.home, "depot-backups")
      FileUtils.mkdir_p(out_root)
      out_file = File.join(out_root, "depot-credentials-#{timestamp}.txt")
      config = File.join(Dir.home, "hdds/.config")
      read = ->(p) { File.file?(p) ? File.read(p).strip : nil }

      lines = ["# depot install credentials (#{Time.now.strftime('%Y-%m-%d %H:%M:%S')})", ""]

      # Cloudflare tunnel token — buried in the dashboard, not
      # retrievable from there after creation; this file is the only
      # copy.
      if v = read.call(File.join(config, "cloudflared/token"))
        lines << "Cloudflare tunnel token: #{v}"
      end

      pc = read_env_file(File.join(config, "depot/prowlarr.env"))
      lines << "NZBGeek API key: #{pc['NZBGEEK_API_KEY']}"  if pc["NZBGEEK_API_KEY"]

      sc = read_env_file(File.join(config, "depot/sabnzbd.env"))
      lines << "Frugal username: #{sc['USENET_USERNAME']}" if sc["USENET_USERNAME"]
      lines << "Frugal password: #{sc['USENET_PASSWORD']}" if sc["USENET_PASSWORD"]

      File.write(out_file, lines.join("\n") + "\n")
      File.chmod(0o600, out_file)

      if target
        # mkdir on remote so scp lands the file in a known
        # depot-backups dir (scp itself won't create the path). Then
        # output ONLY the remote address so the user can scp / cp it
        # from there with no further hunting.
        system("ssh #{target} 'mkdir -p ~/depot-backups'", out: File::NULL, err: File::NULL)
        system("scp -q #{out_file} #{target}:depot-backups/", out: File::NULL, err: File::NULL)
        puts "#{target}:~/depot-backups/#{File.basename(out_file)}"
      else
        puts out_file
      end

      # Skip the post-command summary — backup is a get-the-file-and-go
      # operation, not a status check.
      exit 0
    },
  },
  "completion" => {
    description: "Print the zsh completion script",
    needs_sudo: false,
    action: -> { print_zsh_completion; exit 0 },
  },
}.freeze

def print_help
  puts "Usage: depot <command> [<service>]"
  puts
  puts "Commands:"
  COMMANDS.each do |name, cmd|
    puts "  #{name.ljust(10)} #{cmd[:description]}"
  end
  puts
  puts "Services (for `depot update <service>`): #{SERVICES.map { |s| s.name.downcase }.join(", ")}"
end

# Emit a zsh completion file in fpath/autoload format. Both COMMANDS
# and SERVICES are walked at emit time so re-running this after adding
# a new command or service produces an up-to-date completion list —
# there's no static word list to keep in sync.
#
# Output is the body of an autoloaded completion function — the
# `#compdef depot` directive at the top is what tells zsh's compinit
# to register this file as the completion for the `depot` command.
# install/depot-cli writes the output to /usr/share/zsh/site-functions/_depot,
# which is in zsh's default fpath, so completion just works in every
# new zsh shell with no shellrc changes.
def print_zsh_completion
  commands = COMMANDS.map { |name, cmd| "#{name}:#{cmd[:description]}" }
  services = SERVICES.map { |s| "#{s.name.downcase}:Update #{s.name}" }

  # Position 1 (the command): always offered from our static list,
  # nothing else — no file/dir fallback.
  # Position 2 (the service arg): only meaningful after `update` /
  # `upgrade`; for any other position-1, position 2 completes to
  # nothing (no file fallback either).
  puts "#compdef depot"
  puts
  puts "_arguments \\"
  puts "  '1:command:->command' \\"
  puts "  '2:service:->service'"
  puts
  puts "case $state in"
  puts "  command)"
  puts "    local -a candidates"
  puts "    candidates=("
  commands.each { |c| puts "      #{zsh_quote(c)}" }
  puts "    )"
  puts "    _describe 'depot command' candidates"
  puts "    ;;"
  puts "  service)"
  puts "    case ${words[2]} in"
  puts "      update|upgrade)"
  puts "        local -a services"
  puts "        services=("
  services.each { |s| puts "          #{zsh_quote(s)}" }
  puts "        )"
  puts "        _describe 'service' services"
  puts "        ;;"
  puts "      backup)"
  # _message only shows if zstyle messages format is set — many
  # configs leave it unset and silently swallow the hint. _describe
  # with a synthetic candidate always renders, so the user sees
  # "user@host -- scp target (optional)" in the completion menu.
  puts "        local -a placeholders"
  puts "        placeholders=('user@host:scp target (optional)')"
  puts "        _describe 'scp target' placeholders"
  puts "        ;;"
  puts "    esac"
  puts "    ;;"
  puts "esac"
end

# Wrap a string in single quotes for safe embedding in a zsh array
# literal. Single quotes (not double) so backticks inside the string
# can't be interpreted as command substitution. The `'\''` dance is
# the standard way to embed a literal single quote in a single-quoted
# shell string. UTF-8 passes through as-is (no escape).
def zsh_quote(str)
  "'" + str.gsub("'", "'\\''") + "'"
end

mode = ARGV.first || "help"

# Warm sudo's timestamp so the first sudo call mid-run doesn't bisect
# output with a password prompt. Commands declare their sudo need via
# COMMANDS.
needs_sudo =
  if COMMANDS.key?(mode)
    COMMANDS[mode][:needs_sudo]
  else
    false  # unknown command — print help and exit, no sudo needed
  end

if needs_sudo
  system("sudo -v") || abort("sudo failed")

  # Background thread that re-warms sudo's auth timestamp every 4
  # minutes (sudo's default timeout is 5 min). Without this, a long
  # prompt-collection phase or slow service install can cause sudo
  # to expire mid-run — and because `with_spinner` captures STDOUT,
  # the subsequent "[sudo] password for ..." prompt is invisible
  # and the command times out with "sudo: timed out reading
  # password". Daemon thread so it dies when the main process exits;
  # silent so it doesn't interfere with the spinner output.
  Thread.new do
    loop do
      sleep 240
      system("sudo -v", out: File::NULL, err: File::NULL)
    end
  end
end

begin
  if COMMANDS.key?(mode)
    COMMANDS[mode][:action].call
  else
    puts "Unknown command: #{mode.inspect}"
    puts
    print_help
    exit 1
  end

  puts
  puts "═══ Summary ═══"
  SERVICES.each(&:summary)
rescue Interrupt
  puts
  exit 130
end
