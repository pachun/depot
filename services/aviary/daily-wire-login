#!/usr/bin/env python3
import argparse
import json
import os
from pathlib import Path
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request


CLIENT_ID = "FCgw3nA6cxkcXLVseAQvCSVBrymwvfpE"
ISSUER = "https://authorize.dailywire.com"
REQUEST_TIMEOUT_SECONDS = 30
DEFAULT_POLL_SECONDS = 5
SLOW_DOWN_SECONDS = 5


def post(path, fields):
    request = urllib.request.Request(
        ISSUER + path, data=urllib.parse.urlencode(fields).encode()
    )
    try:
        with urllib.request.urlopen(request, timeout=REQUEST_TIMEOUT_SECONDS) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        return json.load(error)


def save_tokens(path, tokens):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(path.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=".tokens-")
    try:
        with os.fdopen(descriptor, "w") as destination:
            json.dump(tokens, destination)
            destination.flush()
            os.fsync(destination.fileno())
        os.replace(temporary, path)
    finally:
        Path(temporary).unlink(missing_ok=True)


def poll(device):
    deadline = time.monotonic() + device["expires_in"]
    interval = device.get("interval", DEFAULT_POLL_SECONDS)
    while time.monotonic() < deadline:
        time.sleep(interval)
        response = post("/oauth/token", {
            "client_id": CLIENT_ID,
            "grant_type": "urn:ietf:params:oauth:grant-type:device_code",
            "device_code": device["device_code"],
        })
        if response.get("access_token"):
            return response
        error = response.get("error")
        if error == "slow_down":
            interval += SLOW_DOWN_SECONDS
        elif error != "authorization_pending":
            raise SystemExit("Daily Wire login failed: " + str(error))
    raise SystemExit("Login expired. Run this command again to reconnect.")


def main():
    parser = argparse.ArgumentParser(description="Connect Daily Wire to Aviary without storing a password.")
    parser.add_argument("--token-file", type=Path,
                        default=Path.home() / "hdds/.config/aviary/data/daily-wire/tokens.json")
    audience = parser.add_mutually_exclusive_group()
    audience.add_argument("--user-id", action="append", help="Jellyfin user ID allowed to use this membership; repeat for multiple users")
    audience.add_argument("--household", action="store_true", help="Allow every signed-in Aviary user")
    options = parser.parse_args()
    existing = json.loads(options.token_file.read_text()) if options.token_file.exists() else {}
    users = ["*"] if options.household else options.user_id or existing.get("allowed_user_ids")
    if not users:
        parser.error("Specify --user-id JELLYFIN_USER_ID or --household on the first login.")
    device = post("/oauth/device/code", {
        "client_id": CLIENT_ID,
        "audience": "https://api.dailywire.com/",
        "scope": "openid profile offline_access",
    })
    if "device_code" not in device:
        raise SystemExit("Could not start Daily Wire login: " + str(device.get("error")))
    print("Open " + device["verification_uri_complete"], flush=True)
    print("Approve code " + device["user_code"] + " while signed in to Daily Wire.", flush=True)
    tokens = poll(device)
    if not tokens.get("refresh_token"):
        raise SystemExit("Daily Wire did not issue a refresh token. Existing credentials were preserved.")
    tokens.pop("id_token", None)
    tokens["expires_at"] = int(time.time()) + tokens["expires_in"]
    tokens["allowed_user_ids"] = users
    save_tokens(options.token_file, tokens)
    print("Daily Wire connected. Aviary will renew access automatically.")


if __name__ == "__main__":
    os.umask(0o077)
    main()
