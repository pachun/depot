#!/usr/bin/env bash
# install/depot-cli — make `depot` runnable from anywhere on this box
# by symlinking it into /usr/local/bin. After this script runs you can
# type `depot install` / `depot update` / `depot aviary` from any
# directory and from any SSH session, instead of typing
# ~/code/depot/depot.
#
# depot's entry-point uses #!/usr/bin/env ruby, so a ruby on PATH is
# required — orchard installs that via mise (mise use --global ruby).
# If ruby isn't there, install/orchard hasn't been run.
#
# Run once after install/orchard. Idempotent.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if ! command -v ruby >/dev/null 2>&1; then
  echo "ruby not found on PATH — run install/orchard first." >&2
  exit 1
fi

sudo ln -sf "$ROOT/depot" /usr/local/bin/depot

# Install zsh tab-completion. /usr/share/zsh/site-functions is in zsh's
# default fpath, and a file named `_depot` with a `#compdef depot`
# directive at the top is auto-discovered by compinit on every new
# zsh shell — no shellrc changes anywhere. The file regenerates from
# COMMANDS + SERVICES on every install/depot-cli run, so adding a new
# command or service stays in sync with the completion list.
sudo mkdir -p /usr/share/zsh/site-functions
"$ROOT/depot" completion | sudo tee /usr/share/zsh/site-functions/_depot >/dev/null

echo "depot is now runnable from anywhere as: depot install"
