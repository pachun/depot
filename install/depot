# ============================================================
# Prompts (all interactive input up front)
# ============================================================

echo
echo "install/depot — collecting prompts (you can walk away after these)."
echo

# Admin credentials shared across every service's admin user.
if [ -f "$ADMIN_ENV" ]; then
  # shellcheck disable=SC1090
  source "$ADMIN_ENV"
fi
if [ -z "${ADMIN_USERNAME:-}" ]; then
  read -r -p "Admin username: " ADMIN_USERNAME
fi
if [ -z "${ADMIN_PASSWORD:-}" ]; then
  read -r -s -p "Admin password: " ADMIN_PASSWORD
  echo
fi

# ZFS HDD picker
SELECTED_HDD_NAMES=()
if command -v zpool >/dev/null 2>&1 && sudo zpool list "$POOL_NAME" >/dev/null 2>&1; then
  echo "ZFS pool '$POOL_NAME' already exists — skipping HDD prompt."
else
  mapfile -t _hdds < <(
    lsblk -dno NAME,TYPE,ROTA,TRAN \
      | awk '$2 == "disk" && $3 == "1" && $4 == "sata" { print $1 }'
  )
  if [ ${#_hdds[@]} -eq 0 ]; then
    echo "No spinning disks — pool creation will be skipped."
  else
    echo ""
    echo "Spinning disks:"
    _i=1
    for _name in "${_hdds[@]}"; do
      _size=$(lsblk -dno SIZE "/dev/$_name")
      _model=$(lsblk -dno MODEL "/dev/$_name" | tr -s ' ')
      _serial=$(lsblk -dno SERIAL "/dev/$_name")
      printf "  %d) %-6s %-7s %-32s %-22s\n" \
        "$_i" "$_name" "$_size" "$_model" "$_serial"
      _i=$((_i+1))
    done
    echo ""
    read -r -p "Pick disks for the pool (space- or comma-separated indices): " _selection
    _selection=$(echo "$_selection" | tr ',' ' ')
    for _idx in $_selection; do
      if [[ ! "$_idx" =~ ^[0-9]+$ ]] || [ "$_idx" -lt 1 ] || [ "$_idx" -gt ${#_hdds[@]} ]; then
        echo "Invalid index: $_idx — skipping pool creation." >&2
        SELECTED_HDD_NAMES=()
        break
      fi
      SELECTED_HDD_NAMES+=("${_hdds[$((_idx-1))]}")
    done
    if [ "${#SELECTED_HDD_NAMES[@]}" -gt 0 ] && [ ${#SELECTED_HDD_NAMES[@]} -lt 3 ]; then
      echo "RAIDZ1 needs at least 3 disks; got ${#SELECTED_HDD_NAMES[@]}. Skipping."
      SELECTED_HDD_NAMES=()
    elif [ "${#SELECTED_HDD_NAMES[@]}" -gt 0 ]; then
      echo ""
      echo "About to create RAIDZ1 pool '$POOL_NAME' — ALL DATA on these disks will be DESTROYED."
      read -r -p "Type 'destroy and create pool' to confirm: " _confirmation
      if [ "$_confirmation" != "destroy and create pool" ]; then
        echo "Aborted — pool creation will be skipped."
        SELECTED_HDD_NAMES=()
      fi
    fi
  fi
fi

# Downloads SSD picker
SELECTED_SSD_NAME=""
if mountpoint -q "$DOWNLOADING_MOUNT" 2>/dev/null; then
  echo "$DOWNLOADING_MOUNT already mounted — skipping SSD prompt."
else
  _BOOT_PART=$(findmnt -no SOURCE / || true)
  _BOOT_DISK=$(lsblk -dno pkname "$_BOOT_PART" 2>/dev/null || true)
  mapfile -t _ssds < <(
    lsblk -dno NAME,TYPE,ROTA,TRAN \
      | awk '$2 == "disk" && $3 == "0" && $4 == "nvme" { print $1 }'
  )
  _avail_ssds=()
  for _name in "${_ssds[@]}"; do
    [ "$_name" != "$_BOOT_DISK" ] && _avail_ssds+=("$_name")
  done
  if [ ${#_avail_ssds[@]} -gt 0 ]; then
    echo ""
    echo "Non-boot NVMe drives:"
    _i=1
    for _name in "${_avail_ssds[@]}"; do
      _size=$(lsblk -dno SIZE "/dev/$_name")
      _model=$(lsblk -dno MODEL "/dev/$_name" | tr -s ' ')
      _serial=$(lsblk -dno SERIAL "/dev/$_name")
      printf "  %d) %-8s %-7s %-32s %s\n" "$_i" "$_name" "$_size" "$_model" "$_serial"
      _i=$((_i+1))
    done
    echo ""
    read -r -p "Pick the SSD to use for downloading (single index): " _ssd_idx
    if [[ "$_ssd_idx" =~ ^[0-9]+$ ]] && [ "$_ssd_idx" -ge 1 ] && [ "$_ssd_idx" -le ${#_avail_ssds[@]} ]; then
      SELECTED_SSD_NAME="${_avail_ssds[$((_ssd_idx-1))]}"
      echo ""
      echo "About to FORMAT /dev/$SELECTED_SSD_NAME as ext4 — ALL DATA on it will be DESTROYED."
      read -r -p "Type 'format ssd' to confirm: " _confirmation
      if [ "$_confirmation" != "format ssd" ]; then
        echo "Aborted — downloads tier will be skipped."
        SELECTED_SSD_NAME=""
      fi
    fi
  fi
fi

# Tailscale auth key
if [ -f "$TAILSCALE_ENV" ]; then
  # shellcheck disable=SC1090
  source "$TAILSCALE_ENV"
fi
if [ -z "${TAILSCALE_AUTH_KEY:-}" ] && ! sudo tailscale status >/dev/null 2>&1; then
  cat <<'INSTRUCTIONS'

  ── Tailscale auth key ─────────────────────────────────────────────
    1. Open https://login.tailscale.com/admin/settings/keys
    2. Click "Generate auth key"
    3. Set Ephemeral off
    4. Copy the key and paste below
  ───────────────────────────────────────────────────────────────────

INSTRUCTIONS
  read -r -s -p "  Auth key: " TAILSCALE_AUTH_KEY
  echo
fi

# WireGuard config (ProtonVPN)
if [ -f "$WG_ENV" ]; then
  # shellcheck disable=SC1090
  source "$WG_ENV"
fi
if [ -z "${WIREGUARD_PRIVATE_KEY:-}" ] || [ -z "${WIREGUARD_ADDRESSES:-}" ]; then
  read -rp "Path to ProtonVPN WireGuard .conf: " WG_CONF </dev/tty
  if [ ! -f "$WG_CONF" ]; then
    echo "No file at $WG_CONF" >&2
    exit 1
  fi
  WG_CONF_NORMALIZED=$(tr -d '\r' < "$WG_CONF")
  WIREGUARD_PRIVATE_KEY=$(echo "$WG_CONF_NORMALIZED" | grep -iE '^[[:space:]]*PrivateKey' | sed -E 's/^[^=]*=[[:space:]]*//' | tr -d '[:space:]' || true)
  WIREGUARD_ADDRESSES=$(echo "$WG_CONF_NORMALIZED" | grep -iE '^[[:space:]]*Address' | sed -E 's/^[^=]*=[[:space:]]*//' | tr -d '[:space:]' || true)
  if [ -z "$WIREGUARD_PRIVATE_KEY" ] || [ -z "$WIREGUARD_ADDRESSES" ]; then
    echo "Could not extract PrivateKey/Address from $WG_CONF" >&2
    exit 1
  fi
fi
# Strip IPv6 — gluetun's default mode doesn't enable IPv6 inside the
# container, and a dual-stack Address line crashes it with "default
# route not found" looking for an IPv6 default that doesn't exist.
WIREGUARD_ADDRESSES=$(echo "$WIREGUARD_ADDRESSES" | cut -d, -f1 | tr -d '[:space:]')

# Frugal Usenet creds + NZBGeek
if [ -f "$USENET_ENV" ]; then
  # shellcheck disable=SC1090
  source "$USENET_ENV"
fi
if [ -z "${USENET_USERNAME:-}" ]; then
  read -r -p "Frugal Usenet username (newsreader user, not your email): " USENET_USERNAME
fi
if [ -z "${USENET_PASSWORD:-}" ]; then
  read -r -s -p "Frugal Usenet password: " USENET_PASSWORD
  echo
fi
if [ -z "${INDEXER_NZBGEEK_API_KEY:-}" ]; then
  read -r -s -p "NZBGeek API key (from nzbgeek.info account → API): " INDEXER_NZBGEEK_API_KEY
  echo
fi

# IPTorrents (cookie + UA)
if [ -f "$IPT_ENV" ]; then
  # shellcheck disable=SC1090
  source "$IPT_ENV"
fi
if [ -z "${IPT_COOKIE:-}" ] || [ -z "${IPT_USERAGENT:-}" ]; then
  cat <<'INSTRUCTIONS'

  ── IPTorrents setup ───────────────────────────────────────────────
  IPTorrents needs a browser session cookie + the User-Agent that
  came with it. Steps:

    1. Open https://iptorrents.com in your browser and log in.
    2. Press F12 to open DevTools. Click the Network tab.
    3. Reload the page.
    4. Click the very first request in the list (the page itself).
    5. In the Headers tab, scroll to "Request Headers".
    6. Copy the value of "Cookie:" and paste below.
    7. After that prompts, do the same for "User-Agent:".
  ───────────────────────────────────────────────────────────────────

INSTRUCTIONS
fi
if [ -z "${IPT_COOKIE:-}" ]; then
  read -r -p "IPTorrents Cookie: " IPT_COOKIE
fi
if [ -z "${IPT_USERAGENT:-}" ]; then
  read -r -p "IPTorrents User-Agent: " IPT_USERAGENT
fi

# Persist everything we collected so re-runs don't re-prompt.
write_admin_env
write_usenet_env
write_ipt_env
write_tailscale_env
write_wg_env

