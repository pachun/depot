# ============================================================
# Service: gluetun (ProtonVPN client)
# ============================================================

# Net effect: every byte qBittorrent sends or receives goes through
# ProtonVPN's WireGuard tunnel; nothing else (Jellyfin streams,
# Sonarr/Radarr API calls, pacman updates, Tailscale) pays VPN overhead.
#
# WireGuard + NAT-PMP port forwarding for full inbound peer capacity.
# Gluetun renews the forwarded port every ~60s and the qbit-port-sync
# helper (called by VPN_PORT_FORWARDING_UP_COMMAND) pushes the new
# port into qBittorrent's listening-port setting.
#
# FIREWALL_OUTBOUND_SUBNETS whitelists LAN, docker bridge, and tailnet
# CGNAT so the qBit WebUI keeps responding on those networks — without
# it, gluetun's killswitch only allows outbound via the tunnel and
# WebUI replies to LAN/tailnet get dropped.
install_gluetun() {
  mkdir -p ~/hdds/.config/gluetun

  # qbit-port-sync.sh runs INSIDE the gluetun container (alpine +
  # BusyBox), called by gluetun's VPN_PORT_FORWARDING_UP_COMMAND hook
  # whenever a NAT-PMP port is allocated or rotates. It pushes the new
  # port into qBittorrent's listening-port setting via the WebUI API,
  # so qBittorrent stays in sync with whatever ProtonVPN gives us this
  # session — no manual paste into the WebUI required.
  #
  # POSIX sh / BusyBox utilities only — no bashisms, no GNU-only flags
  # — because the runtime environment is the gluetun container, not
  # this host. Auth: qBittorrent's LSIO image ships with "Bypass
  # authentication for clients on localhost" enabled by default, and
  # because qBit shares gluetun's network namespace our requests look
  # like 127.0.0.1 to it. install_qbittorrent's qBittorrent.conf
  # pre-seed makes sure that bypass stays on.
  #
  # `sudo install` because gluetun runs as root inside the container,
  # so any file it created in the bind-mount comes back root-owned on
  # the host; without sudo, an `install` from the daily-driver user
  # can't overwrite it on a re-run.
  sudo install -m 0755 /dev/stdin \
    ~/hdds/.config/gluetun/qbit-port-sync.sh <<'PORT_SYNC_SH'
#!/bin/sh
set -eu

PORT="$1"
[ -z "$PORT" ] && exit 0

# qBittorrent may still be initializing the WebUI when this fires on
# the first tunnel-up + port-allocation race. Wait up to 60s for it.
tries=30
while [ "$tries" -gt 0 ]; do
  wget -q --spider http://localhost:8080/api/v2/app/version 2>/dev/null && break
  sleep 2
  tries=$((tries - 1))
done

wget -qO- \
  --post-data="json={\"listen_port\":$PORT}" \
  http://localhost:8080/api/v2/app/setPreferences >/dev/null
PORT_SYNC_SH

  # 8080 (qBit WebUI) + 6881 (BitTorrent peer port) are published
  # from gluetun. qBittorrent shares the netns and has no port
  # mapping of its own.
  sudo \
    TZ="$(timedatectl show -p Timezone --value)" \
    WIREGUARD_PRIVATE_KEY="$WIREGUARD_PRIVATE_KEY" \
    WIREGUARD_ADDRESSES="$WIREGUARD_ADDRESSES" \
    DEPOT_USER_HOME="$HOME" \
    docker-compose -f "$ROOT/compose/gluetun.yml" up -d
}

# ============================================================
# Service: jellyfin (with first-run wizard helpers)
# ============================================================

# Polls Jellyfin's public endpoint until it responds AND the container
# has finished its EF migrations. 10.11+ has new normalized-username
# migrations that race the wizard endpoints at fresh-container startup,
# and POST /Startup/User silently 4xxs if it lands while the Users table
# is mid-rebuild. "Startup complete" in the container logs is Jellyfin's
# own signal that core init has finished.
jellyfin_wait_for_api() {
  local base_url="$1"
  for _ in $(seq 1 60); do
    if curl -sf "$base_url/System/Info/Public" >/dev/null 2>&1 \
       && docker logs jellyfin 2>&1 | grep -q 'Startup complete'; then
      return 0
    fi
    sleep 1
  done
  echo "  WARN: Jellyfin API didn't respond within 60s" >&2
  return 1
}

# POST to a wizard endpoint and assert 2xx. Wizard endpoints silently
# 4xx if a payload's schema is wrong, or while migrations are still
# settling — without this assertion the script happily marches forward
# from a failed /Startup/User to a "successful" /Startup/Complete and
# leaves us with a wizard-done Jellyfin that has no admin.
_jellyfin_wizard_post() {
  local label="$1" url="$2" body="${3:-}" tmp code
  tmp=$(mktemp)
  if [ -n "$body" ]; then
    code=$(curl -s -o "$tmp" -w '%{http_code}' -X POST \
      -H "Content-Type: application/json" -d "$body" "$url")
  else
    code=$(curl -s -o "$tmp" -w '%{http_code}' -X POST "$url")
  fi
  if [[ ! "$code" =~ ^2 ]]; then
    echo "  ERROR: wizard step '$label' returned HTTP $code" >&2
    echo "         body: $(head -c 400 "$tmp")" >&2
    rm -f "$tmp"
    return 1
  fi
  rm -f "$tmp"
  return 0
}

jellyfin_needs_bootstrap() {
  local base_url="$1" info completed
  info=$(curl -s "$base_url/System/Info/Public")
  completed=$(echo "$info" | jq -r '.StartupWizardCompleted // false')
  [ "$completed" != "true" ]
}

# Drives the startup wizard: pick language, create admin, accept
# defaults, mark complete. Critical ordering: POST /Startup/User is
# an UPDATE of the first user, not a create. Jellyfin's UserManager
# lazily creates a placeholder user "abc" the first time something
# queries the users list; without that placeholder, POST /Startup/User
# 404s because there's no first user to update. GET /Startup/FirstUser
# triggers the placeholder creation. The web-UI wizard hits this GET
# when it renders the user-creation step; we do the same.
jellyfin_run_startup_wizard() {
  local base_url="$1" username="$2" password="$3"

  _jellyfin_wizard_post "Startup/Configuration" \
    "$base_url/Startup/Configuration" \
    '{"UICulture":"en-US","MetadataCountryCode":"US","PreferredMetadataLanguage":"en"}' \
    || return 1

  if ! curl -sf "$base_url/Startup/FirstUser" >/dev/null; then
    echo "  ERROR: GET /Startup/FirstUser failed" >&2
    return 1
  fi

  _jellyfin_wizard_post "Startup/User" \
    "$base_url/Startup/User" \
    "$(jq -nc --arg n "$username" --arg p "$password" '{Name:$n, Password:$p}')" \
    || return 1

  # Verify the placeholder was actually renamed before flipping the
  # "wizard complete" flag. GET /Startup/FirstUser tells us directly
  # what name the first user has — more semantic than checking
  # /Users/Public, which hides the still-placeholder user.
  local first_user_name
  first_user_name=$(curl -sf "$base_url/Startup/FirstUser" 2>/dev/null \
    | jq -r '.Name // empty' 2>/dev/null)
  if [ "$first_user_name" != "$username" ]; then
    echo "  ERROR: /Startup/User returned 2xx but /Startup/FirstUser still" >&2
    echo "         reports '$first_user_name' — expected '$username'." >&2
    return 1
  fi

  _jellyfin_wizard_post "Startup/RemoteAccess" \
    "$base_url/Startup/RemoteAccess" \
    '{"EnableRemoteAccess":true,"EnableAutomaticPortMapping":false}' \
    || return 1

  _jellyfin_wizard_post "Startup/Complete" \
    "$base_url/Startup/Complete" \
    || return 1
}

# Authenticate the admin user and echo the resulting AccessToken.
jellyfin_login() {
  local base_url="$1" username="$2" password="$3"
  curl -s -X POST \
    -H "Content-Type: application/json" \
    -H 'X-Emby-Authorization: MediaBrowser Client="depot", Device="depot-install", DeviceId="depot-install", Version="1.0"' \
    -d "$(jq -nc --arg n "$username" --arg p "$password" '{Username:$n, Pw:$p}')" \
    "$base_url/Users/AuthenticateByName" \
    | jq -r '.AccessToken // empty'
}

# Upsert a Library virtual folder. Idempotent by name lookup.
jellyfin_upsert_library() {
  local base_url="$1" token="$2" name="$3" coll_type="$4" path="$5"
  local existing
  existing=$(curl -s -H "X-Emby-Token: $token" \
    "$base_url/Library/VirtualFolders" \
    | jq -r --arg n "$name" '.[] | select(.Name == $n) | .ItemId')
  if [ -n "$existing" ] && [ "$existing" != "null" ]; then
    return 0
  fi

  # EnableRealtimeMonitor so the user doesn't have to enable it in
  # the dashboard.
  local lib_options
  lib_options=$(jq -nc '{
    EnableRealtimeMonitor: true,
    EnablePhotos: false,
    EnableChapterImageExtraction: false,
    ExtractChapterImagesDuringLibraryScan: false,
    EnableTrickplayImageExtraction: false,
    EnableInternetProviders: true,
    SaveLocalMetadata: true,
    EnableEmbeddedTitles: false,
    EnableEmbeddedEpisodeInfos: false,
    AutomaticRefreshIntervalDays: 30,
    PreferredMetadataLanguage: "en",
    MetadataCountryCode: "US",
    SeasonZeroDisplayName: "Specials",
    PathInfos: [{Path: $path}]
  }' --arg path "$path")

  curl -s -X POST -H "X-Emby-Token: $token" \
    "$base_url/Library/VirtualFolders?name=${name}&collectionType=${coll_type}&refreshLibrary=true" \
    -H "Content-Type: application/json" \
    -d "{\"LibraryOptions\": $lib_options, \"PathInfos\": [{\"Path\": \"$path\"}]}" \
    >/dev/null
}

# Upsert an API key by app name. Returns the key string on stdout.
jellyfin_upsert_api_key() {
  local base_url="$1" token="$2" app_name="$3"
  local existing
  existing=$(curl -s -H "X-Emby-Token: $token" \
    "$base_url/Auth/Keys" \
    | jq -r --arg n "$app_name" '.Items[] | select(.AppName == $n) | .AccessToken')
  if [ -n "$existing" ] && [ "$existing" != "null" ]; then
    echo "$existing"
    return 0
  fi
  curl -s -X POST -H "X-Emby-Token: $token" \
    "$base_url/Auth/Keys?app=$app_name" >/dev/null
  curl -s -H "X-Emby-Token: $token" \
    "$base_url/Auth/Keys" \
    | jq -r --arg n "$app_name" '.Items[] | select(.AppName == $n) | .AccessToken'
}

install_jellyfin() {
  mkdir -p \
    ~/hdds/.config/jellyfin \
    ~/hdds/media/movies \
    ~/hdds/media/tv

  sudo \
    PUID="$(id -u)" \
    PGID="$(id -g)" \
    TZ="$(timedatectl show -p Timezone --value)" \
    DEPOT_USER_HOME="$HOME" \
    docker-compose -f "$ROOT/compose/jellyfin.yml" up -d

  local jf_url="http://localhost:8096"
  if jellyfin_wait_for_api "$jf_url"; then
    if jellyfin_needs_bootstrap "$jf_url"; then
      echo "  running first-run wizard"
      if ! jellyfin_run_startup_wizard "$jf_url" "$ADMIN_USERNAME" "$ADMIN_PASSWORD"; then
        echo "  ERROR: startup wizard failed — see above." >&2
        exit 1
      fi
      sleep 3
      jellyfin_wait_for_api "$jf_url"
    else
      echo "  wizard already complete — skipping"
    fi

    local jf_token
    jf_token=$(jellyfin_login "$jf_url" "$ADMIN_USERNAME" "$ADMIN_PASSWORD")
    if [ -n "$jf_token" ]; then
      echo "  upserting Movies library"
      jellyfin_upsert_library "$jf_url" "$jf_token" "Movies" "movies" "/media/movies"
      echo "  upserting Shows library"
      jellyfin_upsert_library "$jf_url" "$jf_token" "Shows" "tvshows" "/media/tv"
      echo "  upserting aviary + sonarr API keys"
      jellyfin_upsert_api_key "$jf_url" "$jf_token" "aviary" >/dev/null
      jellyfin_upsert_api_key "$jf_url" "$jf_token" "sonarr" >/dev/null
    else
      echo "  WARN: login failed — bootstrap steps after this skipped"
    fi
  fi

  # Intro Skipper plugin — auto-detects intros (and credits, recaps,
  # previews) via audio fingerprinting. Aviary uses this for "Skip
  # Intro" pills. Version pinned to the Jellyfin 10.11 build.
  local intro_version="1.10.11.21"
  local intro_dir="$HOME/hdds/.config/jellyfin/data/plugins/Intro Skipper_${intro_version}"
  if [ ! -f "$intro_dir/IntroSkipper.dll" ]; then
    echo "Installing Jellyfin Intro Skipper plugin v${intro_version}..."
    local tmpzip
    tmpzip=$(mktemp -t intro-skipper-XXXXXX.zip)
    curl -sfL \
      "https://github.com/intro-skipper/intro-skipper/releases/download/10.11/v${intro_version}/intro-skipper-v${intro_version}.zip" \
      -o "$tmpzip"
    mkdir -p "$intro_dir"
    unzip -q -o "$tmpzip" -d "$intro_dir"
    rm -f "$tmpzip"
    docker restart jellyfin >/dev/null
  fi

  # Intel QuickSync hardware-accelerated transcoding via the
  # System/Configuration/encoding REST API. Without this, every
  # transcode runs on CPU and 1080p eats every core. Skips gracefully
  # if the aviary API key doesn't exist yet (fresh wizard).
  echo "Configuring Jellyfin hardware acceleration (QSV)..."
  (
    set +e
    local jf_db=""
    for candidate in \
      "$HOME/hdds/.config/jellyfin/data/data/jellyfin.db" \
      "$HOME/hdds/.config/jellyfin/data/jellyfin.db"
    do
      [ -s "$candidate" ] && { jf_db="$candidate"; break; }
    done
    [ -n "$jf_db" ] || { echo "  skipped: jellyfin.db not found"; exit 0; }

    local jellyfin_api_key
    jellyfin_api_key=$(sqlite3 "$jf_db" \
      "SELECT AccessToken FROM ApiKeys WHERE Name = 'aviary' LIMIT 1;" 2>/dev/null)
    [ -n "$jellyfin_api_key" ] || {
      echo "  skipped: no 'aviary' API key in Jellyfin yet"
      exit 0
    }

    local api_up=0
    for _ in $(seq 1 30); do
      if curl -sf "http://localhost:8096/System/Info/Public" >/dev/null 2>&1; then
        api_up=1; break
      fi
      sleep 1
    done
    [ "$api_up" = "1" ] || {
      echo "  skipped: Jellyfin API didn't respond within 30s"
      exit 0
    }

    local current_enc
    current_enc=$(curl -s -H "X-Emby-Token: $jellyfin_api_key" \
      "http://localhost:8096/System/Configuration/encoding" 2>/dev/null)
    echo "$current_enc" | jq empty >/dev/null 2>&1 || {
      echo "  skipped: encoding config endpoint returned non-JSON"
      exit 0
    }

    local patched
    patched=$(echo "$current_enc" | jq '
      .HardwareAccelerationType = "qsv"
      | .EnableHardwareEncoding = true
      | .HardwareDecodingCodecs = ["h264", "hevc", "mpeg2video", "vc1", "vp8", "vp9"]
      | .EnableDecodingColorDepth10Hevc = true
      | .EnableDecodingColorDepth10Vp9 = true
      | .AllowHevcEncoding = true
    ')

    curl -s -X POST \
      -H "X-Emby-Token: $jellyfin_api_key" \
      -H "Content-Type: application/json" \
      -d "$patched" \
      "http://localhost:8096/System/Configuration/encoding" >/dev/null 2>&1
    echo "  enabled QSV + 10-bit HEVC decode."
  ) || true

  # Expose Jellyfin via tailscale on a DIFFERENT port from Jellyfin's
  # own bind. Jellyfin uses network_mode: host and binds [::]:8096
  # (IPv6 wildcard) on the host netns; tailscale serve also binds
  # tailnet IPs:8096. The IPv6 wildcard conflicts with tailscale's
  # specific tailnet IPv6 bind, so whichever started first wins. Moving
  # tailscale serve to 8443 sidesteps the bind conflict entirely.
  tailscale_serve_https 8443 8096
}

# ============================================================
# Service: qBittorrent (shares gluetun's netns)
# ============================================================

install_qbittorrent() {
  mkdir -p ~/hdds/.config/qbittorrent ~/hdds/seeding ~/downloading/torrents

  # Pre-seed qBittorrent.conf on a fresh install so the LSIO image's
  # first start has "Bypass authentication for clients on localhost"
  # enabled — required for gluetun's qbit-port-sync.sh hook to push
  # the NAT-PMP forwarded port without credentials. Only write when
  # the file doesn't exist yet; qBittorrent persists its full state to
  # this file on shutdown, so on later runs the file already exists
  # with user-accumulated settings.
  local qbit_conf_dir=~/hdds/.config/qbittorrent/qBittorrent/config
  local qbit_conf="$qbit_conf_dir/qBittorrent.conf"
  mkdir -p "$qbit_conf_dir"
  if [ ! -f "$qbit_conf" ]; then
    cat > "$qbit_conf" <<'EOF'
[Preferences]
WebUI\LocalHostAuth=false
EOF
  fi

  sudo \
    PUID="$(id -u)" \
    PGID="$(id -g)" \
    TZ="$(timedatectl show -p Timezone --value)" \
    DEPOT_USER_HOME="$HOME" \
    docker-compose -f "$ROOT/compose/qbittorrent.yml" up -d

  tailscale_serve_https 8080

  # Bootstrap: scrape the LSIO temp password, log in, rotate to
  # admin.env creds, create tv + movies categories, add docker bridge
  # subnet to auth-bypass.
  local qbit_url="http://localhost:8080"
  for _ in $(seq 1 30); do
    if curl -sf "$qbit_url/api/v2/app/version" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  # `|| true` because on a re-run of an already-bootstrapped qBit the
  # temp-password log line has long since rolled out of the buffer, so
  # grep returns 1 — pipefail would propagate that into the command
  # substitution and set -e would kill the dispatcher.
  local temp_pass
  temp_pass=$(docker logs qbittorrent 2>&1 \
    | grep -oP '(?<=temporary password is provided for this session: )\S+' \
    | tail -1 \
    || true)
  [ -z "$temp_pass" ] && temp_pass="adminadmin"

  local cookie_jar
  cookie_jar=$(mktemp)
  trap 'rm -f "$cookie_jar"' RETURN

  _qbit_login() {
    curl -s -c "$cookie_jar" -X POST \
      --data-urlencode "username=$1" \
      --data-urlencode "password=$2" \
      -o /dev/null -w '%{http_code}' \
      "$qbit_url/api/v2/auth/login"
  }

  echo "Bootstrapping qBittorrent..."
  local login_status
  login_status=$(_qbit_login "$ADMIN_USERNAME" "$ADMIN_PASSWORD")
  # Recent qBit returns 204 No Content on successful login, not 200.
  if [[ ! "$login_status" =~ ^2 ]]; then
    login_status=$(_qbit_login "admin" "$temp_pass")
  fi

  if [[ "$login_status" =~ ^2 ]]; then
    local prefs
    prefs=$(jq -nc \
      --arg user "$ADMIN_USERNAME" \
      --arg pass "$ADMIN_PASSWORD" \
      '{
        web_ui_username: $user,
        web_ui_password: $pass,
        bypass_local_auth: true,
        bypass_auth_subnet_whitelist_enabled: true,
        bypass_auth_subnet_whitelist: "172.16.0.0/12,127.0.0.0/8",
        temp_path_enabled: true,
        temp_path: "/torrents",
        save_path: "/seeding"
      }')
    curl -s -b "$cookie_jar" -X POST \
      --data-urlencode "json=$prefs" \
      "$qbit_url/api/v2/app/setPreferences" >/dev/null

    curl -s -b "$cookie_jar" -X POST \
      --data-urlencode "category=tv" \
      --data-urlencode "savePath=/seeding/tv" \
      "$qbit_url/api/v2/torrents/createCategory" >/dev/null
    curl -s -b "$cookie_jar" -X POST \
      --data-urlencode "category=movies" \
      --data-urlencode "savePath=/seeding/movies" \
      "$qbit_url/api/v2/torrents/createCategory" >/dev/null

    echo "  admin creds + categories applied"
  else
    echo "  WARN: couldn't log into qBittorrent (status $login_status)"
  fi
}

