install_docker() {
  sudo pacman -S --needed --noconfirm docker docker-compose
  sudo systemctl enable --now docker.service

  # Group membership takes effect on next login; this run still
  # needs sudo for docker. Doing the usermod anyway so future
  # sessions don't.
  if ! id -nG "$USER" | tr ' ' '\n' | grep -qx docker; then
    sudo usermod -aG docker "$USER"
  fi
}

install_tailscale() {
  sudo pacman -S --needed --noconfirm tailscale
  sudo systemctl enable --now tailscaled.service

  if ! sudo tailscale status >/dev/null 2>&1; then
    if [ -n "${TAILSCALE_AUTH_KEY:-}" ]; then
      sudo tailscale up --auth-key="$TAILSCALE_AUTH_KEY"
    else
      sudo tailscale up
    fi
  fi
}

# ============================================================
# Autologin
# ============================================================

# Auto-login the install user on tty1 so an unattended reboot (UPS
# event, power blip, kernel update) brings the box all the way back
# up without needing a keyboard. NAS lives somewhere without
# peripherals; security boundary is the LAN + tailscale, not the
# local TTY prompt. Service-level recovery already handled by every
# docker-compose's `restart: unless-stopped` + docker.service. All
# this adds is the missing "skip the TTY login" link.
#
# Override is a systemd drop-in so a pacman update of systemd doesn't
# blow it away. Idempotent.
enable_autologin() {
  local override_dir=/etc/systemd/system/getty@tty1.service.d
  local override_file="$override_dir/autologin.conf"
  local desired
  desired=$(cat <<EOF
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin $USER --noclear %I \$TERM
EOF
)
  local current=""
  [ -f "$override_file" ] && current=$(sudo cat "$override_file")
  if [ "$current" = "$desired" ]; then
    return 0
  fi
  sudo mkdir -p "$override_dir"
  echo "$desired" | sudo tee "$override_file" >/dev/null
  sudo systemctl daemon-reload
}

