  echo "Aviary:         $(tailscale_https_url 443)"
  echo "Jellyfin:       $(tailscale_https_url 8443)"
  echo "Jellyseerr:     $(tailscale_https_url 5055)"
  echo "Prowlarr:       $(tailscale_https_url 9696)"
  echo "Radarr:         $(tailscale_https_url 7878)"
  echo "Sonarr:         $(tailscale_https_url 8989)"
  echo "SABnzbd:        $(tailscale_https_url 8086)"
  local qbit_temp
  qbit_temp=$(docker logs qbittorrent 2>&1 \
    | awk -F': ' '/temporary password/ {print $NF; exit}' || true)
  if [ -n "$qbit_temp" ]; then
    echo "qBittorrent:    $(tailscale_https_url 8080) (admin/$qbit_temp)"
  else
    echo "qBittorrent:    $(tailscale_https_url 8080)"
  fi

  local port_file="$HOME/hdds/.config/gluetun/forwarded_port"
  if [ -f "$port_file" ] && [ -s "$port_file" ]; then
