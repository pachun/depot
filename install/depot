install_sabnzbd() {
  mkdir -p ~/hdds/.config/sabnzbd ~/downloading/usenet

  # SABnzbd rejects any request whose Host header isn't in its
  # host_whitelist (defaults to localhost only). Tailscale serve
  # forwards as <tailnet-fqdn>:8085, so add the FQDN to host_whitelist.
  local tailnet_fqdn
  tailnet_fqdn=$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//')

  local sabnzbd_ini=~/hdds/.config/sabnzbd/sabnzbd.ini
  if [ ! -f "$sabnzbd_ini" ]; then
    local sab_api_key
    sab_api_key=$(openssl rand -hex 16)
    umask 077
    cat > "$sabnzbd_ini" <<EOF
[misc]
api_key = $sab_api_key
nzb_key = $sab_api_key
host = 0.0.0.0
port = 8080
download_dir = /usenet/incomplete
complete_dir = /usenet
host_whitelist = ${tailnet_fqdn}, $HOSTNAME, localhost, host.docker.internal
api_logging = 0
inet_exposure = 4

[categories]
[[tv]]
priority = -100
pp = 3
name = tv
dir = /usenet/tv
[[movies]]
priority = -100
pp = 3
name = movies
dir = /usenet/movies

[servers]
[[frugal-primary]]
host = $USENET_PRIMARY_HOST
port = $USENET_PRIMARY_PORT
connections = $USENET_PRIMARY_CONNECTIONS
ssl = 1
username =
password =
priority = 0
enable = 1

[[frugal-secondary]]
host = $USENET_SECONDARY_HOST
port = $USENET_SECONDARY_PORT
connections = $USENET_SECONDARY_CONNECTIONS
ssl = 1
username =
password =
priority = 1
enable = 1

[[frugal-bonus]]
host = $USENET_BONUS_HOST
port = $USENET_BONUS_PORT
connections = $USENET_BONUS_CONNECTIONS
ssl = 1
username =
password =
priority = 2
enable = 1
EOF
  fi

  # Repair an existing sabnzbd.ini's host_whitelist if it doesn't yet
  # match the canonical list.
  local sab_whitelist="${tailnet_fqdn}, $HOSTNAME, localhost, host.docker.internal"
  if [ -n "$tailnet_fqdn" ] && [ -f "$sabnzbd_ini" ]; then
    if ! grep -q "^host_whitelist = ${sab_whitelist}\$" "$sabnzbd_ini"; then
      sed -i "s|^host_whitelist = .*|host_whitelist = ${sab_whitelist}|" "$sabnzbd_ini"
    fi
  fi

  # Tailscale serve at 8085 used to collide with docker-proxy's host
  # bind. Tear down that old mapping so a re-creation cycle works.
  sudo tailscale serve --https=8085 off >/dev/null 2>&1 || true

  # Defensive: a failed docker restart can leave the container in
  # "Up" but with no port bindings. Force-recreate when 8085 isn't
  # in the port list.
  if docker inspect sabnzbd >/dev/null 2>&1; then
    if ! docker ps --filter name=sabnzbd --format '{{.Ports}}' | grep -q '8085'; then
      echo "  sabnzbd container's port mapping is missing — recreating"
      docker rm -f sabnzbd >/dev/null
    fi
  fi

  sudo \
    PUID="$(id -u)" \
    PGID="$(id -g)" \
    TZ="$(timedatectl show -p Timezone --value)" \
    DEPOT_USER_HOME="$HOME" \
    docker-compose -f "$ROOT/compose/sabnzbd.yml" up -d

  # Tailscale serve on 8086 (NOT 8085) — 8085 is docker-proxy's host
  # bind. Different host ports means docker restart doesn't fight
  # tailscale.
  tailscale_serve_https 8086 8085

  local sab_api_key
  sab_api_key=$(grep -m1 '^api_key' "$sabnzbd_ini" | awk -F'=' '{gsub(/ /, "", $2); print $2}')

  echo "Waiting for SABnzbd API..."
  local api_up=0
  for _ in $(seq 1 60); do
    if curl -sf "http://localhost:8085/api?mode=version&apikey=$sab_api_key&output=json" \
         >/dev/null 2>&1; then
      api_up=1; break
    fi
    sleep 1
  done

  if [ "$api_up" != "1" ]; then
    echo "  WARN: SABnzbd API didn't respond within 60s — skipping arr-side wiring."
    return 0
  fi

  # Push Frugal credentials via SABnzbd's API rather than into the INI
  # directly — bash heredocs interpret `$`, backticks, and SABnzbd's INI
  # parser treats `#` as a comment start, any of which silently truncates
  # a strong password.
  _update_sab_creds() {
    curl -s -X POST \
      --data-urlencode "section=servers" \
      --data-urlencode "keyword=$1" \
      --data-urlencode "username=$USENET_USERNAME" \
      --data-urlencode "password=$USENET_PASSWORD" \
      --data-urlencode "apikey=$sab_api_key" \
      "http://localhost:8085/api?mode=set_config" >/dev/null
  }
  _update_sab_creds "frugal-primary"
  _update_sab_creds "frugal-secondary"
  _update_sab_creds "frugal-bonus"

  # In-place python restart (sidesteps the host-port-already-bound dance
  # of cycling the docker container).
  curl -s "http://localhost:8085/api?mode=restart&apikey=$sab_api_key&output=json" >/dev/null
  sleep 2
  for _ in $(seq 1 30); do
    if curl -sf "http://localhost:8085/api?mode=version&apikey=$sab_api_key&output=json" \
         >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  # Register SABnzbd into Sonarr/Radarr.
  local sonarr_cfg="$HOME/hdds/.config/sonarr/config.xml"
  if [ -s "$sonarr_cfg" ]; then
    local sonarr_api_key
    sonarr_api_key=$(grep -oP '(?<=<ApiKey>)[^<]+' "$sonarr_cfg" | head -1 || true)
    if [ -n "$sonarr_api_key" ]; then
      register_sabnzbd_into_arr "http://localhost:8989" "v3" "$sonarr_api_key" "$sab_api_key" "tv"
    fi
  fi

  local radarr_cfg="$HOME/hdds/.config/radarr/config.xml"
  if [ -s "$radarr_cfg" ]; then
    local radarr_api_key
    radarr_api_key=$(grep -oP '(?<=<ApiKey>)[^<]+' "$radarr_cfg" | head -1 || true)
    if [ -n "$radarr_api_key" ]; then
      register_sabnzbd_into_arr "http://localhost:7878" "v3" "$radarr_api_key" "$sab_api_key" "movies"
    fi
  fi
}

