install_jellyseerr() {
  mkdir -p ~/hdds/.config/jellyseerr

  sudo \
    TZ="$(timedatectl show -p Timezone --value)" \
    DEPOT_USER_HOME="$HOME" \
    docker-compose -f "$ROOT/compose/jellyseerr.yml" up -d

  tailscale_serve_https 5055

  local js_url="http://localhost:5055"
  for _ in $(seq 1 30); do
    if curl -sf "$js_url/api/v1/status" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done

  local js_initialized
  js_initialized=$(curl -s "$js_url/api/v1/status" \
    | jq -r '.initialized // false' 2>/dev/null)

  if [ "$js_initialized" = "true" ]; then
    echo "Jellyseerr already initialized — skipping wizard"
    return 0
  fi

  echo "Bootstrapping Jellyseerr..."

  # Adopt the Jellyfin admin user. /api/v1/auth/jellyfin both creates
  # the Jellyseerr admin and wires the Jellyfin connection.
  curl -s -X POST -H "Content-Type: application/json" \
    -c /tmp/js-cookie -b /tmp/js-cookie \
    -d "$(jq -nc \
          --arg user "$ADMIN_USERNAME" \
          --arg pass "$ADMIN_PASSWORD" \
          '{hostname: "host.docker.internal", port: 8096, useSsl: false, username: $user, password: $pass, urlBase: ""}')" \
    "$js_url/api/v1/auth/jellyfin" >/dev/null

  curl -s -X POST -H "Content-Type: application/json" \
    -c /tmp/js-cookie -b /tmp/js-cookie \
    -d '{"initialized": true}' \
    "$js_url/api/v1/settings/main" >/dev/null

  local sonarr_key
  sonarr_key=$(grep -oP '(?<=<ApiKey>)[^<]+' \
    "$HOME/hdds/.config/sonarr/config.xml" 2>/dev/null | head -1 || true)
  if [ -n "$sonarr_key" ]; then
    curl -s -X POST -H "Content-Type: application/json" \
      -c /tmp/js-cookie -b /tmp/js-cookie \
      -d "$(jq -nc --arg key "$sonarr_key" '{
        name: "Sonarr",
        hostname: "host.docker.internal",
        port: 8989,
        useSsl: false,
        apiKey: $key,
        activeProfileId: 4,
        activeProfileName: "HD-1080p",
        rootFolder: "/shows",
        isDefault: true,
        externalUrl: "",
        syncEnabled: true,
        preventSearch: false
      }')" \
      "$js_url/api/v1/settings/sonarr" >/dev/null
  fi

  local radarr_key
  radarr_key=$(grep -oP '(?<=<ApiKey>)[^<]+' \
    "$HOME/hdds/.config/radarr/config.xml" 2>/dev/null | head -1 || true)
  if [ -n "$radarr_key" ]; then
    curl -s -X POST -H "Content-Type: application/json" \
      -c /tmp/js-cookie -b /tmp/js-cookie \
      -d "$(jq -nc --arg key "$radarr_key" '{
        name: "Radarr",
        hostname: "host.docker.internal",
        port: 7878,
        useSsl: false,
        apiKey: $key,
        activeProfileId: 4,
        activeProfileName: "HD-1080p",
        rootFolder: "/movies",
        isDefault: true,
        externalUrl: "",
        minimumAvailability: "released",
        syncEnabled: true,
        preventSearch: false
      }')" \
      "$js_url/api/v1/settings/radarr" >/dev/null
  fi

  rm -f /tmp/js-cookie
  echo "  wizard complete + Jellyfin/Sonarr/Radarr wired"
}

# ============================================================
# Service: aviary (Phoenix LiveView media frontend)
# ============================================================

install_aviary() {
  local src=~/hdds/apps/aviary
  local secret_dir=~/hdds/.config/aviary
  local aviary_env="$secret_dir/.env"
  local secret_key_base_file="$secret_dir/secret_key_base"
  local webhook_secret_file="$secret_dir/sonarr_webhook_secret"
  local aviary_data_dir="$secret_dir/data"

  mkdir -p "$(dirname "$src")" "$secret_dir" "$aviary_data_dir"

  # Source clone — deploy artifact, not a dev tree. fetch + reset rather
  # than pull so a local divergence (shouldn't happen) never blocks the
  # deploy.
  if [ ! -d "$src/.git" ]; then
    git clone https://github.com/pachun/aviary.git "$src"
  else
    git -C "$src" fetch origin main
    git -C "$src" reset --hard origin/main
  fi

  # Phoenix release needs a SECRET_KEY_BASE to sign cookies/sessions.
  # Generate-once-and-persist so rebuilds don't invalidate sessions.
  if [ ! -f "$secret_key_base_file" ]; then
    openssl rand -base64 48 | tr -d '\n' > "$secret_key_base_file"
    chmod 600 "$secret_key_base_file"
  fi
  local secret_key_base
  secret_key_base=$(cat "$secret_key_base_file")

  # Shared secret Sonarr's Connect webhook sends in x-aviary-secret.
  if [ ! -f "$webhook_secret_file" ]; then
    openssl rand -hex 32 > "$webhook_secret_file"
    chmod 600 "$webhook_secret_file"
  fi
  local sonarr_webhook_secret
  sonarr_webhook_secret=$(tr -d '\n' < "$webhook_secret_file")

  # Harvest API keys from each upstream's on-disk state. Always
  # re-read; never cache. The previous caching scheme left stale
  # JELLYFIN_API_KEY pointing at a wiped install.
  local jf_db=""
  for candidate in \
    "$HOME/hdds/.config/jellyfin/data/data/jellyfin.db" \
    "$HOME/hdds/.config/jellyfin/data/jellyfin.db"
  do
    [ -s "$candidate" ] && { jf_db="$candidate"; break; }
  done

  if [ -z "$jf_db" ]; then
    echo "Aviary skipped — Jellyfin's database doesn't exist yet." >&2
    return 0
  fi

  local jellyfin_api_key
  jellyfin_api_key=$(sqlite3 "$jf_db" \
    "SELECT AccessToken FROM ApiKeys WHERE Name = 'aviary' LIMIT 1;" 2>/dev/null || true)
  if [ -z "$jellyfin_api_key" ]; then
    echo "Aviary skipped — no 'aviary' API key in Jellyfin yet." >&2
    return 0
  fi

  local jellyseerr_settings="$HOME/hdds/.config/jellyseerr/settings.json"
  local jellyseerr_api_key=""
  if [ -s "$jellyseerr_settings" ]; then
    jellyseerr_api_key=$(jq -r '.main.apiKey // empty' "$jellyseerr_settings" 2>/dev/null || true)
  fi

  local sonarr_api_key=""
  local sonarr_cfg="$HOME/hdds/.config/sonarr/config.xml"
  if [ -s "$sonarr_cfg" ]; then
    sonarr_api_key=$(grep -oP '(?<=<ApiKey>)[^<]+' "$sonarr_cfg" 2>/dev/null | head -1 || true)
  fi

  local radarr_api_key=""
  local radarr_cfg="$HOME/hdds/.config/radarr/config.xml"
  if [ -s "$radarr_cfg" ]; then
    radarr_api_key=$(grep -oP '(?<=<ApiKey>)[^<]+' "$radarr_cfg" 2>/dev/null | head -1 || true)
  fi

  # Rewrite .env from scratch with current values (no stale-cache leak).
  umask 077
  {
    printf 'JELLYFIN_API_KEY=%s\n' "$jellyfin_api_key"
    printf 'JELLYSEERR_API_KEY=%s\n' "$jellyseerr_api_key"
    printf 'SONARR_API_KEY=%s\n' "$sonarr_api_key"
    printf 'RADARR_API_KEY=%s\n' "$radarr_api_key"
  } > "$aviary_env"

  local phx_host
  phx_host=$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//')
  [ -z "$phx_host" ] && phx_host="$HOSTNAME"
  local jellyfin_public_url="https://${phx_host}:8443"

  sudo \
    TZ="$(timedatectl show -p Timezone --value)" \
    DEPOT_USER_HOME="$HOME" \
    SRC="$src" \
    SECRET_KEY_BASE="$secret_key_base" \
    PHX_HOST="$phx_host" \
    JELLYFIN_URL=http://host.docker.internal:8096 \
    JELLYFIN_PUBLIC_URL="$jellyfin_public_url" \
    JELLYFIN_API_KEY="$jellyfin_api_key" \
    JELLYSEERR_URL=http://host.docker.internal:5055 \
    JELLYSEERR_API_KEY="$jellyseerr_api_key" \
    SONARR_URL=http://host.docker.internal:8989 \
    SONARR_API_KEY="$sonarr_api_key" \
    SONARR_WEBHOOK_SECRET="$sonarr_webhook_secret" \
    RADARR_URL=http://host.docker.internal:7878 \
    RADARR_API_KEY="$radarr_api_key" \
    AVIARY_DATA_DIR="$aviary_data_dir" \
    HOST_UID="$(id -u)" \
    HOST_GID="$(id -g)" \
    docker-compose -f "$ROOT/compose/aviary.yml" up -d --build

  # Wait for the BEAM to actually accept work before migrating. up -d
  # returns when the container starts, not when Phoenix is listening.
  # bin/aviary eval against an un-booted release exits non-zero. Don't
  # redirect stderr — silent migrate failures left aviary running
  # against an empty DB in earlier versions.
  echo "Waiting for aviary endpoint..."
  for _ in $(seq 1 60); do
    if curl -sf http://localhost:4000/ >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  docker exec aviary bin/aviary eval "Aviary.Release.migrate()"

  # Register the Sonarr Connect webhook so aviary gets health events
  # and can re-fire EpisodeSearch for grabs that failed during an
  # unhealthy window. Idempotent (keyed by notification name "Aviary").
  if [ -n "$sonarr_api_key" ]; then
    local webhook_url="http://host.docker.internal:4000/api/sonarr/webhook"
    local sonarr_host_url="http://localhost:8989"
    local payload
    payload=$(cat <<EOF
{
  "name": "Aviary",
  "implementation": "Webhook",
  "implementationName": "Webhook",
  "configContract": "WebhookSettings",
  "tags": [],
  "fields": [
    {"name": "url", "value": "$webhook_url"},
    {"name": "method", "value": 1},
    {"name": "username", "value": ""},
    {"name": "password", "value": ""},
    {"name": "headers", "value": [{"key": "x-aviary-secret", "value": "$sonarr_webhook_secret"}]}
  ],
  "onGrab": false,
  "onDownload": false,
  "onUpgrade": false,
  "onRename": false,
  "onSeriesAdd": false,
  "onSeriesDelete": false,
  "onEpisodeFileDelete": false,
  "onEpisodeFileDeleteForUpgrade": false,
  "onHealthIssue": false,
  "onHealthRestored": true,
  "onApplicationUpdate": true,
  "onManualInteractionRequired": false,
  "supportsOnGrab": true,
  "supportsOnDownload": true,
  "supportsOnHealthIssue": true,
  "supportsOnHealthRestored": true,
  "supportsOnApplicationUpdate": true
}
EOF
    )
    local existing_id
    existing_id=$(curl -s -H "X-Api-Key: $sonarr_api_key" \
      "${sonarr_host_url}/api/v3/notification" \
      | jq -r '.[] | select(.name=="Aviary") | .id' | head -1)
    if [ -n "$existing_id" ] && [ "$existing_id" != "null" ]; then
      curl -s -X PUT \
        -H "X-Api-Key: $sonarr_api_key" \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "${sonarr_host_url}/api/v3/notification/${existing_id}" >/dev/null
    else
      curl -s -X POST \
        -H "X-Api-Key: $sonarr_api_key" \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "${sonarr_host_url}/api/v3/notification" >/dev/null
    fi
  fi

  # Aviary as HTTPS on 443 → https://<hostname>.<tailnet>.ts.net/ with
  # no port suffix.
  tailscale_serve_https 443 4000
}

